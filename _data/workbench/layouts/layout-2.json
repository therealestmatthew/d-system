{
  "schema_version": 1,
  "layout_id": "layout-2",
  "name": "Layout 2 — Terminal Bottom",
  "slots": [
    {
      "slot_id": "notes-strip",
      "display_name": "Notes",
      "admits": ["talking-points"],
      "default_panel": "talking-points"
    },
    {
      "slot_id": "main",
      "display_name": "Main",
      "admits": ["overview", "html-viewer"],
      "default_panel": "overview"
    },
    {
      "slot_id": "explorer",
      "display_name": "Explorer",
      "admits": ["file-browser", "idea-explorer", "backlog-explorer"],
      "default_panel": null
    },
    {
      "slot_id": "terminal",
      "display_name": "Terminal",
      "admits": ["terminal"],
      "default_panel": "terminal"
    }
  ],
  "grid": {
    "columns": ["1fr", "1fr", "1fr"],
    "rows": ["1fr", "1.6fr"],
    "areas": [
      "notes-strip main explorer",
      "terminal terminal terminal"
    ]
  }
}
