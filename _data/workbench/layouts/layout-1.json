{
  "schema_version": 2,
  "layout_id": "layout-1",
  "name": "Layout 1 — Terminal Left",
  "slots": [
    { "slot_id": "terminal", "display_name": "Terminal" },
    { "slot_id": "notes-strip", "display_name": "Notes" },
    { "slot_id": "main", "display_name": "Main" },
    { "slot_id": "explorer", "display_name": "Explorer" }
  ],
  "panels": [
