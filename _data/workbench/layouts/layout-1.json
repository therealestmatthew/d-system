    { "panel_id": "terminal-cmd", "eligible_slots": ["terminal", "main"] },
    { "panel_id": "terminal-powershell", "eligible_slots": ["terminal", "main"] },
    { "panel_id": "html-viewer", "eligible_slots": ["terminal", "main"] },
    { "panel_id": "notes-strip", "eligible_slots": ["notes-strip"] },
    { "panel_id": "file-browser", "eligible_slots": ["explorer"] },
    { "panel_id": "idea-explorer", "eligible_slots": ["explorer"] },
    { "panel_id": "backlog-explorer", "eligible_slots": ["explorer"] }
