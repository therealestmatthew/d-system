{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Person",
  "description": "A stakeholder, collaborator, or contact associated with one or more projects",
  "type": "object",
  "required": ["id", "name"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "role": { "type": ["string", "null"] },
    "organization": { "type": ["string", "null"] },
    "email": { "type": ["string", "null"], "format": "email" },
    "projects": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Project IDs this person is associated with"
    },
    "notes": { "type": "string", "default": "" }
  }
}
