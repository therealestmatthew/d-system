#!/bin/sh
# Blocks a commit that leaks private portfolio content or paths — see phase-priv-04 and
# docs/08-governance/OPS-009-check-no-private-content.md.
#
# Install once:
#   git config core.hooksPath tools/git-hooks
# or copy this file to .git/hooks/pre-commit (.git/hooks/ is not tracked, so it does not
# install itself).

set -e
cd "$(git rev-parse --show-toplevel)"
uv run python tools/check_no_private_content.py
