#!/usr/bin/env python3
"""Run an AWS command against the team's sandbox account, with the profile its mode allows.

Every AWS command an agent runs goes through this wrapper. A PreToolUse hook
(`tools/hooks/aws_guard.py`) refuses AWS commands and SDK use anywhere else, and
`.claude/settings.json` denies the bare `aws` command as a second layer.

**The IAM roles are the boundary.** The sandbox has two roles (`aws/README.md`): a read-only role
and a deploy role whose IAM rights are limited to `/app/` roles (create, change and delete them
when they carry the permission boundary, pass them to the product's services, read them) plus
listing roles and reading the boundary and AWS managed policies,
and which has no Organizations, account or billing permissions. Each machine has one
named profile for each. The wrapper picks the profile by mode, so a `read` command runs with the
read-only role and cannot change anything, whatever it asks for:

- `read` and `whoami` use the read profile;
- `write` and `exec` use the deploy profile;
- `synth` uses no profile at all: it runs `cdk synth` with every AWS credential source removed, so
  any agent can synthesize a CDK app and read the CloudFormation it produces without being able
  to reach AWS.

The wrapper:

- reads the two profiles and the region from per-machine configuration that is never committed:
  the environment variables IDEA_REALIZATION_AWS_READ_PROFILE, IDEA_REALIZATION_AWS_DEPLOY_PROFILE
  and IDEA_REALIZATION_AWS_REGION, or else the `aws_read_profile`, `aws_deploy_profile` and
  `aws_region` values that `plugins/idea-realization/scripts/paths.py` prints;
- refuses to run when a value it needs is missing, when either profile is `default`, or when the
  two profiles are the same;
- refuses a command that passes its own `--profile`, `--region` or `--endpoint-url`, and removes
  credential environment variables, so the configured profile is the only source of credentials;
- in `read` mode, runs only read operations (describe, list, get and the like) and refuses the
  read operations that reveal a secret.

Usage:

    tools/aws-sandbox read <service> <operation> [args...]     read profile; reads only
    tools/aws-sandbox write <service> <operation> [args...]    deploy profile (aws-deploy only)
    tools/aws-sandbox exec <command> [args...]                 deploy profile in the environment
                                                               of another tool (cdk, sam, a script)
    tools/aws-sandbox whoami                                   both profile names, and the read
                                                               profile's caller identity
    tools/aws-sandbox synth [--dir <cdk app dir>] [cdk args]   `cdk synth` with no credentials
                                                               (every agent); needs no profile

`synth` removes every AWS_ and BOTO_ variable, sets AWS_EC2_METADATA_DISABLED=true and points
AWS_CONFIG_FILE and AWS_SHARED_CREDENTIALS_FILE at /dev/null, so neither a profile, a credentials
file, an SSO cache entry, a credential process nor the instance metadata service is reachable.
It refuses `--profile` and `--role-arn`. Context lookups (for example `Vpc.fromLookup`) fail
under it, exactly as in CI: commit `cdk.context.json`. `--dir` runs it in another directory, for
example the product repository's `infra/`.

Deleting anything is matched by `ask` rules in `.claude/settings.json`, so a person approves each
delete when it is requested. IAM, Organizations, account and billing changes are refused by the
deploy role itself. The hook and the settings rules are guardrails; the roles are the boundary.
"""

from __future__ import annotations

import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PATHS_SCRIPT = ROOT / "plugins" / "idea-realization" / "scripts" / "paths.py"

READ_PROFILE_ENV = "IDEA_REALIZATION_AWS_READ_PROFILE"
DEPLOY_PROFILE_ENV = "IDEA_REALIZATION_AWS_DEPLOY_PROFILE"
REGION_ENV = "IDEA_REALIZATION_AWS_REGION"
CONFIG_ENV = {"aws_read_profile": READ_PROFILE_ENV, "aws_deploy_profile": DEPLOY_PROFILE_ENV,
              "aws_region": REGION_ENV}

# Operations allowed in read mode, by prefix of the operation name.
READ_PREFIXES = ("describe-", "list-", "get-", "head-", "batch-get-", "lookup-", "search-",
                 "validate-", "estimate-", "simulate-", "filter-", "preview-")
# Whole operations allowed in read mode.
READ_OPERATIONS = {"ls", "tail", "query", "scan", "wait", "start-query", "stop-query"}
# Read operations that would put a secret or a credential in the transcript. Refused in every mode.
SECRET_OPERATIONS = {
    ("secretsmanager", "get-secret-value"),
    ("secretsmanager", "batch-get-secret-value"),
    ("ssm", "get-parameter"),
    ("ssm", "get-parameters"),
    ("ssm", "get-parameters-by-path"),
    ("ecr", "get-login-password"),
    ("ecr", "get-authorization-token"),
    ("sts", "get-session-token"),
    ("sts", "get-federation-token"),
    ("iam", "get-credential-report"),
    ("kms", "decrypt"),
    ("lambda", "get-function-configuration"),
    ("lambda", "get-function"),
    ("ec2", "get-password-data"),
}
FORBIDDEN_OPTIONS = ("--profile", "--region", "--endpoint-url")
# cdk options that would name a credential source; refused in synth mode.
SYNTH_FORBIDDEN_OPTIONS = ("--profile", "--role-arn", "-r")
# The environment synth mode adds: no metadata service, no config or credentials file.
NO_CREDENTIALS_ENV = {"AWS_EC2_METADATA_DISABLED": "true", "AWS_CONFIG_FILE": os.devnull,
                      "AWS_SHARED_CREDENTIALS_FILE": os.devnull}
CREDENTIAL_ENV = ("AWS_PROFILE", "AWS_DEFAULT_PROFILE", "AWS_ACCESS_KEY_ID",
                  "AWS_SECRET_ACCESS_KEY", "AWS_SESSION_TOKEN", "AWS_REGION",
                  "AWS_DEFAULT_REGION")


class Refused(Exception):
    """The command is not run; the message says why."""


def configured(env: dict[str, str]) -> dict[str, str]:
    """The two profiles and the region, from the environment or else the plugin's configuration.

    Validates all three: a missing value, a `default` profile, or one profile used for both roles
    is refused, whichever mode is asked for, so a misconfigured machine is caught on first use."""
    values = {key: env.get(var, "") for key, var in CONFIG_ENV.items()}
    if not all(values.values()) and PATHS_SCRIPT.is_file() and shutil.which("uv"):
        result = subprocess.run(["uv", "run", "--quiet", str(PATHS_SCRIPT)], cwd=ROOT,
                                capture_output=True, text=True, check=False)
        for line in result.stdout.splitlines():
            key, _, value = line.partition(":")
            if key.strip() in values and not values[key.strip()]:
                values[key.strip()] = value.strip()
    for key, var in CONFIG_ENV.items():
        if not values[key]:
            raise Refused(f"{key} is not configured: set {key} in .idea-realization/local.yaml, "
                          f"or {var}, or the {key} plugin option on this machine "
                          "(see aws/README.md)")
    for key in ("aws_read_profile", "aws_deploy_profile"):
        if values[key] == "default":
            raise Refused(f"{key} is 'default'; name the dedicated sandbox profile for that role")
    if values["aws_read_profile"] == values["aws_deploy_profile"]:
        raise Refused("aws_read_profile and aws_deploy_profile are the same profile; each role "
                      "needs its own")
    return values


def check_options(args: list[str]) -> None:
    for arg in args:
        if any(arg == opt or arg.startswith(opt + "=") for opt in FORBIDDEN_OPTIONS):
            raise Refused(f"{arg.split('=')[0]} is set by the wrapper; do not pass it")


def check_aws(mode: str, args: list[str]) -> None:
    if len(args) < 2:
        raise Refused(f"usage: tools/aws-sandbox {mode} <service> <operation> [args...]")
    service, operation = args[0], args[1]
    check_options(args)
    if (service, operation) in SECRET_OPERATIONS:
        raise Refused(f"{service} {operation} reveals a secret; it is not run through agents")
    if service == "configure":
        raise Refused("aws configure changes this machine's AWS configuration; a person does that")
    if mode == "read" and not (operation.startswith(READ_PREFIXES)
                               or operation in READ_OPERATIONS):
        raise Refused(f"{service} {operation} is not a read operation; read mode runs "
                      "describe/list/get-style operations only")
    if mode == "read" and any(arg == "--delete" or arg.startswith("--delete=") for arg in args):
        raise Refused("--delete is not a read")


def synth_environment(env: dict[str, str]) -> dict[str, str]:
    """`env` with every AWS credential source removed: no AWS_ or BOTO_ variable (keys, tokens,
    profiles, container and web-identity credentials, config and credentials file locations), no
    profile names from this wrapper's configuration, no CDK account default, and the files and
    the metadata service switched off."""
    clean = {k: v for k, v in env.items()
             if not k.startswith(("AWS_", "BOTO_", "CDK_DEFAULT_"))
             and k not in (READ_PROFILE_ENV, DEPLOY_PROFILE_ENV)}
    return {**clean, **NO_CREDENTIALS_ENV}


def build_synth(args: list[str],
                env: dict[str, str]) -> tuple[list[str], dict[str, str], str | None]:
    """The `cdk synth` command, its credential-free environment and its directory."""
    directory = None
    if args[:1] == ["--dir"]:
        if len(args) < 2:
            raise Refused("usage: tools/aws-sandbox synth [--dir <cdk app dir>] [cdk args]")
        directory, args = args[1], args[2:]
        if not Path(directory).is_dir():
            raise Refused(f"--dir {directory} is not a directory")
    for arg in args:
        if any(arg == opt or arg.startswith(opt + "=") for opt in SYNTH_FORBIDDEN_OPTIONS):
            raise Refused(f"{arg.split('=')[0]} names a credential source; synth runs with none")
    clean = synth_environment(env)
    local = Path(directory or ".") / "node_modules" / ".bin" / "cdk"
    if local.is_file():
        cdk = [str(local.resolve())]
    elif shutil.which("cdk", path=clean.get("PATH", "")):
        cdk = ["cdk"]
    else:
        cdk = ["npx", "--no", "cdk"]
    return [*cdk, "synth", *args], clean, directory


def build(argv: list[str], env: dict[str, str]) -> tuple[list[str], dict[str, str]]:
    """The command to run and its environment, or Refused."""
    if not argv or argv[0] not in {"read", "write", "exec", "whoami", "synth"}:
        raise Refused("usage: tools/aws-sandbox read|write|exec|whoami|synth ...")
    mode, args = argv[0], argv[1:]
    if mode == "synth":
        command, clean, _ = build_synth(args, env)
        return command, clean
    config = configured(env)
    region = config["aws_region"]
    profile = config["aws_read_profile" if mode in {"read", "whoami"} else "aws_deploy_profile"]
    clean = {k: v for k, v in env.items() if k not in CREDENTIAL_ENV}
    if mode == "whoami":
        print(f"read profile: {config['aws_read_profile']}\n"
              f"deploy profile: {config['aws_deploy_profile']}\nregion: {region}")
        return ["aws", "sts", "get-caller-identity", "--profile", profile,
                "--region", region], clean
    if mode == "exec":
        if not args:
            raise Refused("usage: tools/aws-sandbox exec <command> [args...]")
        if re.fullmatch(r"(.*/)?aws", args[0]):
            # The AWS CLI under exec gets exactly the checks write mode applies.
            check_aws("write", args[1:])
            return ["aws", *args[1:], "--profile", profile, "--region", region], clean
        check_options(args)
        return args, {**clean, "AWS_PROFILE": profile, "AWS_REGION": region,
                      "AWS_DEFAULT_REGION": region}
    check_aws(mode, args)
    return ["aws", *args, "--profile", profile, "--region", region], clean


def warn_ambient(env: dict[str, str]) -> None:
    """Print the machine-rule findings (tools/check_aws_machine.py) as warnings; never refuse."""
    sys.path.insert(0, str(ROOT / "tools"))
    try:
        import check_aws_machine
    except ImportError:
        return
    for finding in check_aws_machine.static_findings(env):
        print(f"aws-sandbox: warning: {finding}", file=sys.stderr)


def main(argv: list[str]) -> int:
    warn_ambient(dict(os.environ))
    directory = None
    try:
        if argv[:1] == ["synth"]:
            command, env, directory = build_synth(argv[1:], dict(os.environ))
        else:
            command, env = build(argv, dict(os.environ))
    except Refused as refused:
        print(f"aws-sandbox: refused: {refused}", file=sys.stderr)
        return 2
    return subprocess.run(command, env=env, cwd=directory, check=False).returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
