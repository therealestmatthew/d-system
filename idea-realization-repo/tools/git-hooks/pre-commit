#!/bin/sh
# Blocks a commit that leaks a deny-listed identifier or a file under the private directory, or
# that leaves the repository check failing (a stale catalog or idea view included).
#
# Never bypass a failure with --no-verify: commit the fix, or, if the check itself is wrong, stop
# and report it.
#
# Install once per clone:
#   git config core.hooksPath tools/git-hooks

set -e
cd "$(git rev-parse --show-toplevel)"
uv run python tools/check_confidential.py
uv run plugins/idea-realization/scripts/check.py
