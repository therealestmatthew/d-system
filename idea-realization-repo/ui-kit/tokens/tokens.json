{
  "meta": {
    "name": "ui-kit design tokens",
    "version": "0.1.0",
    "description": "Single source for every --ui-* custom property. Edit this file, then run ui-kit/tools/build_tokens.py; ui-kit/dist/tokens.css is generated from it and never edited by hand.",
    "origin": "Ported from d-system templates/styles/house-tokens.json and tools/generate_house_css.py (house status colours and magenta accent kept); plan: ux-component-plan.md sections 2, 3a, 3d, 9."
  },
  "font": {
    "sans": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, \"Noto Sans\", \"Liberation Sans\", sans-serif",
    "mono": "ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace"
  },
  "fs": {
    "xs": "12px",
    "sm": "13px",
    "md": "14px",
    "lg": "16px",
    "xl": "20px",
    "2xl": "24px",
    "3xl": "32px"
  },
  "lh": {
    "tight": "1.2",
    "ui": "1.45",
    "prose": "1.6"
  },
  "fw": {
    "regular": "400",
    "semibold": "600",
    "bold": "700"
  },
  "space": {
    "0": "0px",
    "1": "2px",
    "2": "4px",
    "3": "8px",
    "4": "12px",
    "5": "16px",
    "6": "24px",
    "7": "32px",
    "8": "48px",
    "9": "64px"
  },
  "ctl": {
    "sm": "24px",
    "md": "32px",
    "lg": "40px"
  },
  "radius": {
    "none": "0px",
    "sm": "4px",
    "md": "6px",
    "lg": "10px",
    "pill": "999px"
  },
  "shadow": {
    "e0": "none",
    "e1": "0 1px 2px var(--ui-color-shadow), 0 2px 8px var(--ui-color-shadow)",
    "e2": "0 4px 12px var(--ui-color-shadow), 0 16px 40px var(--ui-color-shadow)",
    "e3": "0 8px 20px var(--ui-color-shadow), 0 24px 56px var(--ui-color-shadow)"
  },
  "z": {
    "base": "0",
    "sticky": "100",
    "dock": "200",
    "dropdown": "1000",
    "overlay": "1100",
    "modal": "1200",
    "toast": "1300",
    "tooltip": "1400"
  },
  "dur": {
    "fast": "120ms",
    "base": "180ms",
    "slow": "280ms"
  },
  "ease": {
    "standard": "cubic-bezier(.2, 0, 0, 1)",
    "exit": "cubic-bezier(.4, 0, 1, 1)"
  },
  "focus": {
    "width": "2px",
    "offset": "2px"
  },
  "reduced_motion": {
    "dur": {
      "fast": "0ms",
      "base": "0ms",
      "slow": "0ms"
    }
  },
  "density": {
    "compact": {
      "fs": {
        "sm": "12px",
        "md": "13px",
        "lg": "15px"
      },
      "lh": {
        "ui": "1.35"
      },
      "space": {
        "3": "6px",
        "4": "8px",
        "5": "12px",
        "6": "16px",
        "7": "24px"
      },
      "ctl": {
        "md": "28px",
        "lg": "32px"
      }
    },
    "comfortable": {
      "fs": {
        "sm": "14px",
        "md": "15px",
        "lg": "17px"
      },
      "lh": {
        "ui": "1.5"
      },
      "space": {
        "4": "16px",
        "5": "20px",
        "6": "32px",
        "7": "40px"
      },
      "ctl": {
        "sm": "28px",
        "md": "36px",
        "lg": "44px"
      }
    }
  },
  "auto_density": {
    "density": "compact",
    "below": {
      "width": "68.75em",
      "height": "50em"
    },
    "note": "Below either size (1100px wide or 800px high at the initial 16px) the app shell takes this density unless it or an ancestor sets data-density=\"comfortable\". Emitted as @media (width < W), (height < H) on .ui-shell; report pages have no .ui-shell and keep their size."
  },
