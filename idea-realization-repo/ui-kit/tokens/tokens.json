  "ai_distinctness": {
    "min_hue_gap_deg": 30,
    "chroma_floor": 0.15,
    "from": ["accent", "ok", "warn", "info", "err"]
  },
  "contrast_pairs": [
    {"fg": "text", "bg": "bg", "min": 4.5, "use": "body text on the page"},
    {"fg": "text", "bg": "surface", "min": 4.5, "use": "body text in a panel"},
    {"fg": "text", "bg": "surface-2", "min": 4.5, "use": "body text on a raised area"},
    {"fg": "text", "bg": "sunken", "min": 4.5, "use": "text in inputs and code"},
    {"fg": "text", "bg": "surface-e1", "min": 4.5, "use": "text in menus and popovers"},
    {"fg": "text", "bg": "surface-e2", "min": 4.5, "use": "text in dialogs"},
    {"fg": "text", "bg": "surface-e3", "min": 4.5, "use": "text in toasts"},
    {"fg": "text", "bg": "selection", "min": 4.5, "use": "text on a selected row or selected text"},
    {"fg": "muted", "bg": "bg", "min": 4.5, "use": "secondary text on the page"},
    {"fg": "muted", "bg": "surface", "min": 4.5, "use": "secondary text in a panel"},
    {"fg": "muted", "bg": "surface-2", "min": 4.5, "use": "secondary text on a raised area"},
    {"fg": "muted", "bg": "sunken", "min": 4.5, "use": "placeholders in inputs"},
    {"fg": "line-strong", "bg": "bg", "min": 3.0, "use": "control borders (WCAG 1.4.11)"},
    {"fg": "line-strong", "bg": "surface", "min": 3.0, "use": "control borders in a panel"},
    {"fg": "on-accent", "bg": "accent", "min": 4.5, "use": "primary button label"},
    {"fg": "on-accent", "bg": "accent-hover", "min": 4.5, "use": "primary button label on hover"},
    {"fg": "accent", "bg": "bg", "min": 4.5, "use": "links and active nav as text"},
    {"fg": "accent", "bg": "surface", "min": 4.5, "use": "links in a panel"},
    {"fg": "accent-2", "bg": "bg", "min": 3.0, "use": "second series mark (graphic)"},
    {"fg": "focus", "bg": "bg", "min": 3.0, "use": "focus ring on the page"},
    {"fg": "focus", "bg": "surface", "min": 3.0, "use": "focus ring in a panel"},
    {"fg": "ai", "bg": "bg", "min": 4.5, "use": "AI marker as text on the page"},
    {"fg": "ai", "bg": "surface", "min": 4.5, "use": "AI marker as text in a panel"},
    {"fg": "ok", "bg": "ok-bg", "min": 4.5, "use": "ok pill"},
    {"fg": "ok", "bg": "bg", "min": 4.5, "use": "ok text on the page"},
    {"fg": "warn", "bg": "warn-bg", "min": 4.5, "use": "warn pill"},
    {"fg": "warn", "bg": "bg", "min": 4.5, "use": "warn text on the page"},
    {"fg": "info", "bg": "info-bg", "min": 4.5, "use": "info pill"},
    {"fg": "info", "bg": "bg", "min": 4.5, "use": "info text on the page"},
    {"fg": "err", "bg": "err-bg", "min": 4.5, "use": "err pill"},
    {"fg": "err", "bg": "bg", "min": 4.5, "use": "err text on the page"}
  ]
