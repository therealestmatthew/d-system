{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenySecretAndCredentialReads",
      "Effect": "Deny",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:BatchGetSecretValue",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath",
        "ecr:GetAuthorizationToken",
        "sts:GetSessionToken",
        "sts:GetFederationToken",
        "iam:GenerateCredentialReport",
        "iam:GetCredentialReport",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "ec2:GetPasswordData"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyDecryptExceptThroughS3AndDynamoDB",
      "Effect": "Deny",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringNotLike": {
          "kms:ViaService": [
            "s3.*.amazonaws.com",
            "dynamodb.*.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "DenyActionsThatCostOrChangeState",
      "Effect": "Deny",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream",
        "bedrock:Converse",
        "bedrock:ConverseStream",
        "lambda:InvokeFunction",
        "sts:AssumeRole",
        "bedrock:InvokeModelWithBidirectionalStream",
        "bedrock:InvokeAgent",
        "bedrock:InvokeFlow",
        "bedrock:Retrieve",
        "bedrock:RetrieveAndGenerate",
        "bedrock:AgenticRetrieveStream",
        "bedrock:ApplyGuardrail",
        "textract:Analyze*",
        "textract:Detect*",
        "textract:Start*"
      ],
      "Resource": "*"
    }
  ]
}
