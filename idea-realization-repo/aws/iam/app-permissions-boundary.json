{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAtMostWhatTheDeployRoleMayDo",
      "Effect": "Allow",
      "NotAction": [
        "iam:*",
        "organizations:*",
        "account:*",
        "billing:*",
        "budgets:*",
        "ce:*",
        "cur:*",
        "aws-portal:*",
        "payments:*",
        "tax:*",
        "invoicing:*",
        "purchase-orders:*",
        "freetier:*",
        "savingsplans:*",
        "sso:*",
        "sso-directory:*",
        "identitystore:*",
        "sts:AssumeRole",
        "sts:GetFederationToken"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowPassingAppRolesToTextractAndBedrock",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/app/*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "textract.amazonaws.com",
            "bedrock.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "DenyOrganizationAccountBillingAndRoleAssumption",
      "Effect": "Deny",
      "Action": [
        "organizations:*",
        "account:*",
        "billing:*",
        "budgets:*",
        "ce:*",
        "cur:*",
        "aws-portal:*",
        "payments:*",
        "tax:*",
        "invoicing:*",
        "purchase-orders:*",
        "freetier:*",
        "savingsplans:*",
        "sso:*",
        "sso-directory:*",
        "identitystore:*",
        "sts:AssumeRole",
        "sts:GetFederationToken",
        "sts:GetSessionToken"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenySecretReads",
      "Effect": "Deny",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:BatchGetSecretValue"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyTurningOffTheAuditTrailOrItsLocks",
      "Effect": "Deny",
      "Action": [
        "cloudtrail:StopLogging",
        "cloudtrail:DeleteTrail",
        "cloudtrail:UpdateTrail",
        "config:StopConfigurationRecorder",
        "config:DeleteConfigurationRecorder",
        "guardduty:DeleteDetector",
        "guardduty:UpdateDetector",
        "s3:BypassGovernanceRetention",
        "s3:PutBucketObjectLockConfiguration"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyKeyPolicyAndKeyDeletion",
      "Effect": "Deny",
      "Action": [
        "kms:PutKeyPolicy",
        "kms:ScheduleKeyDeletion",
        "kms:DisableKey"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyInferenceProfilesOutsideTheUS",
      "Effect": "Deny",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": "*",
      "Condition": {
        "Null": {
          "bedrock:InferenceProfileArn": "false"
        },
        "ArnNotLike": {
          "bedrock:InferenceProfileArn": "arn:aws:bedrock:*:*:inference-profile/us.*"
        }
      }
    },
    {
      "Sid": "DenyDirectFoundationModelInvocation",
      "Effect": "Deny",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": "arn:aws:bedrock:*::foundation-model/*",
      "Condition": {
        "Null": {
          "bedrock:InferenceProfileArn": "true"
        }
      }
    },
    {
      "Sid": "DenyOtherRegionsExceptUSInferenceProfileRouting",
      "Effect": "Deny",
      "NotAction": [
        "iam:*",
        "sts:*",
        "organizations:*",
        "support:*",
        "cloudfront:*",
        "route53:*",
        "waf:*",
        "health:*",
        "s3:ListAllMyBuckets"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": "REPLACE_WITH_SANDBOX_REGION"
        },
        "ArnNotLike": {
          "bedrock:InferenceProfileArn": "arn:aws:bedrock:*:*:inference-profile/us.*"
        }
      }
    },
    {
      "Sid": "DenyOutsideTheProductFunctionChanges",
      "Effect": "Deny",
      "Action": [
        "lambda:CreateFunction",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:PublishVersion",
        "lambda:CreateAlias",
        "lambda:UpdateAlias",
        "lambda:DeleteAlias",
        "lambda:DeleteFunction",
        "lambda:InvokeFunction",
        "lambda:AddPermission",
        "lambda:RemovePermission",
        "lambda:CreateFunctionUrlConfig",
        "lambda:UpdateFunctionUrlConfig",
        "lambda:PutFunctionEventInvokeConfig",
        "lambda:UpdateFunctionEventInvokeConfig"
      ],
      "NotResource": "arn:aws:lambda:*:*:function:REPLACE_WITH_PRODUCT_NAME-*"
    },
    {
      "Sid": "DenyOutsideTheProductStateMachineChanges",
      "Effect": "Deny",
      "Action": [
        "states:CreateStateMachine",
        "states:UpdateStateMachine",
        "states:DeleteStateMachine",
        "states:PublishStateMachineVersion",
        "states:CreateStateMachineAlias",
        "states:UpdateStateMachineAlias",
        "states:StartExecution",
        "states:StartSyncExecution"
      ],
      "NotResource": "arn:aws:states:*:*:stateMachine:REPLACE_WITH_PRODUCT_NAME-*"
    },
    {
      "Sid": "DenyOutsideTheProductStackChanges",
      "Effect": "Deny",
      "Action": [
        "cloudformation:CreateStack",
        "cloudformation:UpdateStack",
        "cloudformation:DeleteStack",
        "cloudformation:CreateChangeSet",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:CancelUpdateStack",
        "cloudformation:ContinueUpdateRollback",
        "cloudformation:RollbackStack",
        "cloudformation:SetStackPolicy",
        "cloudformation:UpdateTerminationProtection"
      ],
      "NotResource": "arn:aws:cloudformation:*:*:stack/REPLACE_WITH_PRODUCT_NAME-*/*"
    },
    {
      "Sid": "DenyOutsideTheProductBuildProjectChanges",
      "Effect": "Deny",
      "Action": [
        "codebuild:CreateProject",
        "codebuild:UpdateProject",
        "codebuild:DeleteProject",
        "codebuild:StartBuild",
        "codebuild:StartBuildBatch",
        "codebuild:RetryBuild",
        "codebuild:RetryBuildBatch"
      ],
      "NotResource": "arn:aws:codebuild:*:*:project/REPLACE_WITH_PRODUCT_NAME-*"
    },
    {
      "Sid": "DenyOutsideTheProductAmplifyChanges",
      "Effect": "Deny",
      "Action": [
        "amplify:UpdateApp",
        "amplify:DeleteApp",
        "amplify:UpdateBranch",
        "amplify:DeleteBranch",
        "amplify:CreateDeployment",
        "amplify:StartDeployment"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:ResourceTag/project": "REPLACE_WITH_PRODUCT_NAME"
        }
      }
    },
    {
      "Sid": "DenyOutsideTheProductAmplifyProjectTag",
      "Effect": "Deny",
      "Action": [
        "amplify:TagResource",
        "amplify:UntagResource"
      ],
      "Resource": "*",
      "Condition": {
        "ForAnyValue:StringEquals": {
          "aws:TagKeys": [
            "project"
          ]
        },
        "StringNotEquals": {
          "aws:ResourceTag/project": "REPLACE_WITH_PRODUCT_NAME"
        }
      }
    },
    {
      "Sid": "DenyOutsideTheProductAmplifyBuildJobs",
      "Effect": "Deny",
      "Action": "amplify:StartJob",
      "Resource": "*"
    }
  ]
}
