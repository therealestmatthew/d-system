{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowDeployingExceptIdentityOrganizationAccountAndBilling",
      "Effect": "Allow",
      "NotAction": [
        "iam:*",
        "organizations:*",
        "account:*",
        "billing:*",
        "budgets:*",
        "ce:*",
        "cur:*",
        "aws-portal:*",
        "payments:*",
        "tax:*",
        "invoicing:*",
        "purchase-orders:*",
        "freetier:*",
        "savingsplans:*",
        "sso:*",
        "sso-directory:*",
        "identitystore:*",
        "sts:AssumeRole",
        "sts:GetFederationToken"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowPassingAppRolesToTheProductsServices",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/app/*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "states.amazonaws.com",
            "lambda.amazonaws.com",
            "bedrock.amazonaws.com",
            "textract.amazonaws.com",
            "cognito-idp.amazonaws.com",
            "cloudtrail.amazonaws.com",
            "vpc-flow-logs.amazonaws.com",
            "amplify.amazonaws.com",
            "events.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "AllowReadingAppRoles",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListRoleTags",
        "iam:ListInstanceProfilesForRole"
      ],
      "Resource": "arn:aws:iam::*:role/app/*"
    },
    {
      "Sid": "AllowListingRoles",
      "Effect": "Allow",
      "Action": "iam:ListRoles",
      "Resource": "*"
    },
    {
      "Sid": "AllowReadingTheBoundaryAndAwsManagedPolicies",
      "Effect": "Allow",
      "Action": [
        "iam:GetPolicy",
        "iam:GetPolicyVersion"
      ],
      "Resource": [
        "arn:aws:iam::REPLACE_WITH_SANDBOX_ACCOUNT_ID:policy/app-permissions-boundary",
        "arn:aws:iam::aws:policy/*"
      ]
    },
    {
      "Sid": "AllowChangingAppRolesOnlyUnderTheBoundary",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePermissionsBoundary"
      ],
      "Resource": "arn:aws:iam::*:role/app/*",
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::REPLACE_WITH_SANDBOX_ACCOUNT_ID:policy/app-permissions-boundary"
        }
      }
    },
    {
      "Sid": "AllowMaintainingAppRoles",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateRole",
        "iam:UpdateRoleDescription",
        "iam:UpdateAssumeRolePolicy"
      ],
      "Resource": "arn:aws:iam::*:role/app/*"
    },
    {
      "Sid": "DenyPassingOrReadingRolesOutsideApp",
      "Effect": "Deny",
      "Action": [
        "iam:PassRole",
        "iam:GetRole"
      ],
      "NotResource": "arn:aws:iam::*:role/app/*"
    },
    {
      "Sid": "DenyAppRoleChangesWithoutTheBoundary",
      "Effect": "Deny",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePermissionsBoundary"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::REPLACE_WITH_SANDBOX_ACCOUNT_ID:policy/app-permissions-boundary"
        }
      }
    },
    {
      "Sid": "DenyRemovingOrChangingTheBoundary",
      "Effect": "Deny",
      "Action": [
        "iam:DeleteRolePermissionsBoundary",
        "iam:DeleteUserPermissionsBoundary",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicy",
        "iam:DeletePolicyVersion",
        "iam:SetDefaultPolicyVersion",
        "iam:TagPolicy",
        "iam:UntagPolicy"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyEveryIamChangeOutsideAppRoles",
      "Effect": "Deny",
      "Action": [
        "iam:Add*",
        "iam:Attach*",
        "iam:Change*",
        "iam:Create*",
        "iam:Deactivate*",
        "iam:Delete*",
        "iam:Detach*",
        "iam:Enable*",
        "iam:Generate*",
        "iam:Put*",
        "iam:Remove*",
        "iam:Reset*",
        "iam:Resync*",
        "iam:Set*",
        "iam:Tag*",
        "iam:Untag*",
        "iam:Update*",
        "iam:Upload*"
      ],
      "NotResource": "arn:aws:iam::*:role/app/*"
    },
    {
      "Sid": "DenyOrganizationAccountAndBilling",
      "Effect": "Deny",
      "Action": [
        "organizations:*",
        "account:*",
        "billing:*",
        "budgets:*",
        "ce:*",
        "cur:*",
        "aws-portal:*",
        "payments:*",
        "tax:*",
        "invoicing:*",
        "purchase-orders:*",
        "freetier:*",
        "savingsplans:*",
        "sso:*",
        "sso-directory:*",
        "identitystore:*",
        "sts:AssumeRole",
        "sts:GetFederationToken"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyTurningOffTheBaselineTrail",
      "Effect": "Deny",
      "Action": [
        "cloudtrail:StopLogging",
        "cloudtrail:DeleteTrail",
        "cloudtrail:UpdateTrail",
        "cloudtrail:PutEventSelectors"
      ],
      "Resource": "arn:aws:cloudtrail:*:*:trail/REPLACE_WITH_BASELINE_TRAIL_NAME"
    },
    {
      "Sid": "DenyTurningOffConfigAndGuardDuty",
      "Effect": "Deny",
      "Action": [
        "config:StopConfigurationRecorder",
        "config:DeleteConfigurationRecorder",
        "guardduty:DeleteDetector",
        "guardduty:UpdateDetector"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyBypassingObjectLockRetention",
      "Effect": "Deny",
      "Action": "s3:BypassGovernanceRetention",
      "Resource": "*"
    },
    {
      "Sid": "DenySecretReads",
      "Effect": "Deny",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:BatchGetSecretValue"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyInferenceProfilesOutsideTheUS",
      "Effect": "Deny",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": "*",
      "Condition": {
        "Null": {
          "bedrock:InferenceProfileArn": "false"
        },
        "ArnNotLike": {
          "bedrock:InferenceProfileArn": "arn:aws:bedrock:*:*:inference-profile/us.*"
        }
      }
    },
    {
      "Sid": "DenyDirectFoundationModelInvocation",
      "Effect": "Deny",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": "arn:aws:bedrock:*::foundation-model/*",
      "Condition": {
        "Null": {
          "bedrock:InferenceProfileArn": "true"
        }
      }
    },
    {
      "Sid": "DenyOtherRegionsExceptUSInferenceProfileRouting",
      "Effect": "Deny",
      "NotAction": [
        "iam:*",
        "sts:*",
        "organizations:*",
        "support:*",
        "cloudfront:*",
        "route53:*",
        "waf:*",
        "health:*",
        "s3:ListAllMyBuckets"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": "REPLACE_WITH_SANDBOX_REGION"
        },
        "ArnNotLike": {
          "bedrock:InferenceProfileArn": "arn:aws:bedrock:*:*:inference-profile/us.*"
        }
      }
    }
  ]
}
