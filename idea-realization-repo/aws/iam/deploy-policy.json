{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowDeployingExceptIdentityOrganizationAccountAndBilling",
      "Effect": "Allow",
      "NotAction": [
        "iam:*",
        "organizations:*",
        "account:*",
        "billing:*",
        "budgets:*",
        "ce:*",
        "cur:*",
        "aws-portal:*",
        "payments:*",
        "tax:*",
        "invoicing:*",
        "purchase-orders:*",
        "freetier:*",
        "savingsplans:*",
        "sso:*",
        "sso-directory:*",
        "identitystore:*",
        "sts:AssumeRole",
        "sts:GetFederationToken"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowAttachingAppRolesCreatedByAPerson",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole",
        "iam:GetRole"
      ],
      "Resource": "arn:aws:iam::*:role/app/*"
    },
    {
      "Sid": "AllowListingRoles",
      "Effect": "Allow",
      "Action": "iam:ListRoles",
      "Resource": "*"
    },
    {
      "Sid": "DenyPassingOrReadingRolesOutsideApp",
      "Effect": "Deny",
      "Action": [
        "iam:PassRole",
        "iam:GetRole"
      ],
      "NotResource": "arn:aws:iam::*:role/app/*"
    },
    {
      "Sid": "DenyEveryIamChange",
      "Effect": "Deny",
      "Action": [
        "iam:Add*",
        "iam:Attach*",
        "iam:Change*",
        "iam:Create*",
        "iam:Deactivate*",
        "iam:Delete*",
        "iam:Detach*",
        "iam:Enable*",
        "iam:Generate*",
        "iam:Put*",
        "iam:Remove*",
        "iam:Reset*",
        "iam:Resync*",
        "iam:Set*",
        "iam:Tag*",
        "iam:Untag*",
        "iam:Update*",
        "iam:Upload*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyOrganizationAccountAndBilling",
      "Effect": "Deny",
      "Action": [
        "organizations:*",
        "account:*",
        "billing:*",
        "budgets:*",
        "ce:*",
        "cur:*",
        "aws-portal:*",
        "payments:*",
        "tax:*",
        "invoicing:*",
        "purchase-orders:*",
        "freetier:*",
        "savingsplans:*",
        "sso:*",
        "sso-directory:*",
        "identitystore:*",
        "sts:AssumeRole",
        "sts:GetFederationToken"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyTurningOffTheAuditTrail",
      "Effect": "Deny",
      "Action": [
        "cloudtrail:StopLogging",
        "cloudtrail:DeleteTrail",
        "cloudtrail:UpdateTrail",
        "config:StopConfigurationRecorder",
        "config:DeleteConfigurationRecorder",
        "guardduty:DeleteDetector",
        "guardduty:UpdateDetector"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenySecretReads",
      "Effect": "Deny",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:BatchGetSecretValue"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyOtherRegions",
      "Effect": "Deny",
      "NotAction": [
        "iam:*",
        "sts:*",
        "organizations:*",
        "support:*",
        "cloudfront:*",
        "route53:*",
        "waf:*",
        "health:*",
        "s3:ListAllMyBuckets"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": "REPLACE_WITH_SANDBOX_REGION"
        }
      }
    }
  ]
}
