{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "designs.schema.json",
  "title": "designs.json written by PROMPT-040 G2 (competing designs for ADR-023's open parameters)",
  "type": "object",
  "additionalProperties": false,
  "required": ["provenance", "designs"],
  "properties": {
    "provenance": {"$ref": "provenance.schema.json"},
    "designs": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "parameter", "name", "mechanism", "data_shape", "rulings_honoured", "failure_paths", "existing_code", "test_method", "drawbacks", "recommended"],
        "properties": {
          "id": {"type": "string", "pattern": "^G2-(RS|GR|OD|LF)-\\d$"},
          "parameter": {"type": "string", "enum": ["router-shadow", "grant-records", "owner-desk-events", "lease-file"]},
          "name": {"type": "string", "minLength": 1},
          "mechanism": {"type": "string", "minLength": 1},
          "data_shape": {"type": "string", "minLength": 1, "description": "A JSON example or field list of what is stored or exchanged"},
          "rulings_honoured": {"type": "array", "minItems": 1, "items": {"$ref": "evidence.schema.json"}, "description": "ADR-023 lines this design is built on"},
          "failure_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "existing_code": {"type": "array", "items": {"$ref": "evidence.schema.json"}, "description": "Code on dev the design reuses or must change; empty if none"},
          "test_method": {"type": "string", "minLength": 1},
          "drawbacks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "recommended": {"type": "boolean", "description": "Gemini's recommendation within its parameter; exactly one per parameter. A proposal, not a decision"}
        }
      }
    }
  }
}
