{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rule-register.schema.json",
  "title": "rule-register.json written by PROMPT-040 G3 (a draft register of canonical rule statements, for idea 000402)",
  "type": "object",
  "additionalProperties": false,
  "required": ["provenance", "rules"],
  "properties": {
    "provenance": {"$ref": "provenance.schema.json"},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "topic", "canonical_statement", "stated_in", "enforced_by", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^R-\\d{3}$"},
          "topic": {"type": "string", "minLength": 1},
          "canonical_statement": {"type": "string", "minLength": 1, "description": "The rule in one sentence, quoted from the document that should own it"},
          "stated_in": {"type": "array", "minItems": 1, "items": {"$ref": "evidence.schema.json"}},
          "enforced_by": {"type": "array", "items": {"$ref": "evidence.schema.json"}, "description": "Code, test, hook or check that enforces it; empty if none was found"},
          "status": {"type": "string", "enum": ["consistent", "contradicted", "duplicated", "unenforced"]},
          "finding_ids": {"type": "array", "items": {"type": "string", "pattern": "^G3-F\\d{3}$"}}
        }
      }
    }
  }
}
